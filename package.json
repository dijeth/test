{
  "name": "it-smi",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "prestart": "prisma generate",
    "start:dev": "nest start --watch",
    "prestart:dev": "prisma generate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma generate && ts-node -r tsconfig-paths/register prisma/seed.ts",
    "dev": "npm run db:up && prisma migrate deploy && prisma generate && nest start --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.1.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/graphql": "^14.1.0",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.9",
    "graphql": "^16.14.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^12.0.11",
    "@types/node": "^22.20.5",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
